rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.email == "admin@tavykorea.vn" || 
         request.auth.token.admin == true);
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. Users Collection - Strict lockdown to owner or admin (removed test_user_tan123 backdoor)
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // 2. Orders Collection - Hardened Security Lockdown (R4)
    match /orders/{orderId} {
      // Helper function: Validate strict schema for guest order creation
      function isValidOrderCreate() {
        let data = request.resource.data;
        return data.keys().hasAll(['customerName', 'customerPhone', 'items', 'totalVnd']) &&
               data.customerName is string && data.customerName.size() > 0 &&
               data.customerPhone is string && data.customerPhone.size() >= 9 &&
               data.items is list && data.items.size() > 0 &&
               data.totalVnd is number && data.totalVnd > 0 &&
               (!('status' in data) || data.status == 'pending') &&
               (!('paymentStatus' in data) || data.paymentStatus == 'unpaid');
      }

      function isAllowedGuestOrderUpdate() {
        let allowedKeys = ['depositProofImage', 'depositProofUploadedAt', 'customerReportedPaid', 'paymentDue', 'updatedAt'];
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedKeys) &&
               (!('depositProofImage' in request.resource.data) ||
                (request.resource.data.depositProofImage is string && request.resource.data.depositProofImage.size() < 800000));
      }

      // Read single document: Admin, order owner (by UID/Email), or single-doc lookup by exact Order ID / 10-digit VN Phone (list remains strictly blocked)
      allow get: if isAdmin() || 
                    (isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.userEmail == request.auth.token.email)) ||
                    (resource == null || orderId.matches('^ORD-[0-9A-Za-z_-]{6,}$') || orderId.matches('^0[35789][0-9]{8}$'));

      // Query/list orders: Restricted strictly to authenticated admins or user filtering by own email
      allow list: if isAdmin() || 
                     (isAuthenticated() && request.auth.token.email == resource.data.userEmail);

      // Create orders: Authenticated admin or valid guest order creation payload
      allow create: if isAdmin() || isValidOrderCreate();

      // Update orders:
      // - Status / paymentStatus / financial amounts strictly restricted to authenticated admins
      // - Guest updates strictly restricted to whitelisted proof upload fields
      allow update: if isAdmin() || isAllowedGuestOrderUpdate();

      // Delete orders: Strictly restricted to authenticated admins
      allow delete: if isAdmin();
    }

    // 3. Products Catalog Collection
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. System Config (Exchange rates, shipping fees — block public read of telegram_bot secret)
    match /system_config/{configId} {
      allow read: if configId != "telegram_bot" || isAdmin();
      allow write: if isAdmin();
    }

    // 5. Pending Products (Strictly restricted to Admin)
    match /pending_products/{productId} {
      allow read, write: if isAdmin();
    }

    // 6. AI Operations Manager Tasks (Strictly restricted to Admin)
    match /ai_manager_tasks/{taskId} {
      allow read, write: if isAdmin();
    }

    // 7. Site Analytics (Pageviews Counter - Today, Week, Month, Year)
    match /site_analytics/{docId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update: if docId == "overview" &&
        request.resource.data.keys().hasOnly(['allTime', 'days', 'weeks', 'months', 'years', 'lastUpdated']) &&
        (!('allTime' in request.resource.data) || request.resource.data.allTime is number);
      allow delete: if isAdmin();
    }

    // 8. Guest Phone Order Index (Single-doc get by exact 10-digit VN phone, no list)
    match /guest_phone_orders/{phoneId} {
      allow get: if phoneId.matches('^0[35789][0-9]{8}$');
      allow list: if isAdmin();
      allow create, update: if phoneId.matches('^0[35789][0-9]{8}$')
        && request.resource.data.keys().hasOnly(['phone', 'orderIds', 'updatedAt'])
        && request.resource.data.orderIds is list
        && request.resource.data.orderIds.size() <= 50;
      allow delete: if isAdmin();
    }
  }
}
